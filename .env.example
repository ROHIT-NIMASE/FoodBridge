# Copy this to .env and fill in your values.
# .env is gitignored and never committed.

FOODBRIDGE_DB_HOST=127.0.0.1
FOODBRIDGE_DB_PORT=3306
FOODBRIDGE_DB_USER=root
FOODBRIDGE_DB_PASSWORD=yourpassword
FOODBRIDGE_DB_NAME=foodbridge

# Optional: connection pool size (default 5)
# FOODBRIDGE_DB_POOL_SIZE=5
